* {

  margin: 0;

  padding: 0;

  box-sizing: border-box;

}



body {

  font-family: Arial, sans-serif;

  background-color: #f4f4f4;

  color: #333;

  line-height: 1.6;

}



header {

  background-color: #222;

  color: white;

  text-align: center;

  padding: 40px 20px;

}



header h1 {

  font-size: 32px;

  margin-bottom: 10px;

}



header h2 {

  font-size: 22px;

  margin-bottom: 10px;

}



header p {

  color: #ccc;

}



nav {

  background-color: #333;

  text-align: center;

  padding: 15px;

}



nav a {

  color: white;

  text-decoration: none;

  margin: 0 15px;

  font-weight: bold;

}



nav a:hover {

  color: #00aaff;

}



main {

  max-width: 1000px;

  margin: 30px auto;

  padding: 0 20px;

}



section {

  background-color: white;

  margin-bottom: 25px;

  padding: 30px;

  border-radius: 8px;

  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);

}



section h2 {

  color: #222;

  margin-bottom: 15px;

  border-bottom: 2px solid #00aaff;

  padding-bottom: 8px;

}



ul {

  list-style-position: inside;

}



li {

  margin-bottom: 8px;

}



article {

  background-color: #f7f7f7;

  padding: 20px;

  margin-top: 15px;

  border-left: 4px solid #00aaff;

  border-radius: 5px;

}



article h3 {

  margin-bottom: 8px;

  color: #222;

}



#contato p {

  margin-bottom: 8px;

}



#contato {

  margin-bottom: 40px;

}
